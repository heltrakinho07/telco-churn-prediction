# Dockerfile para a API REST (FastAPI).
# Uso local / demonstração:
#   docker build -f Dockerfile.api -t churn-api .
#   docker run -p 8000:8000 churn-api
# Depois abrir http://localhost:8000/docs
FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ ./src/
COPY api/ ./api/
COPY models/gradient_boosting_churn.joblib ./models/gradient_boosting_churn.joblib

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
